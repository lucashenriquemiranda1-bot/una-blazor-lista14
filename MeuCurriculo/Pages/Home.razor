@page "/"

<PageTitle>Currículo | Dev .NET</PageTitle>

<div class="container py-4">
    <div class="row">
        <div class="col-lg-4">
            <div class="text-center p-4 bg-light rounded-3 mb-4">
                <img src="" <h3>Lucas Miranda</h3>
                <p class="text-muted">Desempregado</p>
            </div>
        </div>

        <div class="col-lg-8">
            <h2 class="mb-4">Analista e Desenvolvedor de sistemas</h2>
            
            @foreach (var exp in MinhasExperiencias)
            {
                <ExperienciaCard Dados="exp" />
            }
        </div>
    </div>
</div>

@code {
    private List<Experiencia> MinhasExperiencias = new()
    {
        new Experiencia {
            Empresa = "Sem Experiencia profissional",
            Cargo = "Estudante",
            Inicio = "2025",
            Descricao = "Qualificação Profissional em Programação de Soluções Computacionais, Certificado DUAL, Qualificação Profissional em Modelagem e Persistência de Dados e Qualificação Profissional em Ambientes Computacionais e Conectividade. "
        },
        new Experiencia {
            Empresa = "Curso de Análise e Desenvolvimento de sistemas",
            Cargo = "Cursando",
            Inicio = "2025", Fim = "2027",
            Descricao = "é uma graduação tecnológica focada na formação prática para o mercado de TI. Ele capacita profissionais a criar, analisar, projetar, testar e manter softwares e sistemas, com forte demanda para desenvolvedores front-end, backend, full-stack e analistas."
        }
    };
}